# AI Text-to-Image Generator - Environment Configuration

# Flask Server Configuration
FLASK_ENV=development
FLASK_PORT=5000
FLASK_DEBUG=False
SECRET_KEY=college_bca_text_to_image_secret_key_2026

# Generation Backend Mode:
# 'auto'      : Automatically detects GPU/local diffusers or Hugging Face API
# 'diffusers' : Runs local PyTorch Diffusers pipeline on your local machine (CUDA/CPU)
# 'hf_api'    : Uses Hugging Face Inference API (Fast, no heavy local GPU needed)
GENERATION_MODE=hf_api

# Hugging Face Access Token (Required if using GENERATION_MODE=hf_api or gated models)
# Get your free token at: https://huggingface.co/settings/tokens
HF_TOKEN=

# Model ID:
# For local Diffusers or HF API:
# Recommended options:
# - stabilityai/stable-diffusion-xl-base-1.0 (High quality SDXL)
# - runwayml/stable-diffusion-v1-5 (Classic Stable Diffusion v1.5)
# - segmind/tiny-sd (Ultra-fast lightweight model, great for local CPU testing)
# - black-forest-labs/FLUX.1-schnell (State of the art FLUX model)
MODEL_ID=stabilityai/stable-diffusion-xl-base-1.0

# Inference Settings for Local Diffusers
NUM_INFERENCE_STEPS=30
GUIDANCE_SCALE=7.5
IMAGE_WIDTH=512
IMAGE_HEIGHT=512
